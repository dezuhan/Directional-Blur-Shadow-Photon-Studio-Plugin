{
  "manifestVersion": 1,
  "sdkVersion": 1,
  "id": "photon-directional-shadow",
  "name": "Directional Shadow",
  "version": "0.9.1",
  "main": "index.html",
  "panels": [
    {
      "id": "shadow",
      "label": "Directional Shadow",
      "ui": "custom",
      "minimumSize": {
        "width": 340,
        "height": 460
      }
    }
  ],
  "commands": [
    {
      "id": "shadow.open",
      "label": "Directional Blur Shadow…",
      "scope": "document",
      "panel": "shadow",
      "menu": "Plugins",
      "binding": "Ctrl+Shift+D",
      "keywords": [
        "shadow",
        "blur",
        "directional",
        "drop shadow",
        "affinity"
      ]
    }
  ],
  "permissions": {
    "document": "readWrite"
  }
}
